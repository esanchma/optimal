{
  "name": "optimal",
  "version": "0.1.0",
  "description": "OPML/RSS launcher that opens new feed items in your browser.",
  "type": "module",
  "bin": {
    "optimal": "./src/optimal.ts"
  },
  "scripts": {
    "optimal": "bun run src/optimal.ts",
    "build": "bun build --compile --outfile optimal src/optimal.ts",
    "check": "bun run src/optimal.ts --help"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
